# Copy to .env and fill in your own values. Never commit .env.

# MySQL
DB_HOST=localhost
DB_USER=buynder
DB_PASSWORD=change-me
DB_NAME=pokemarket

# Flask session signing key: any long random string, e.g. python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# true = the login cookie is HTTPS-only (set it when the site is served over HTTPS)
COOKIE_SECURE=false
FLASK_DEBUG=false

# Addresses you open the dev site at over plain http besides localhost (comma-separated), e.g. a LAN IP
DEV_HOSTS=

# Card data and prices (https://poketrace.com, Pro plan)
POKETRACE_API_KEY=

# Optional: pokemontcg.io API key (older card-number lookups)
POKEMON_TCG_API_KEY=

# Optional: Discord webhook for price alerts
DISCORD_WEBHOOK_URL=

# Optional, ops agents (agents/): a private Discord channel's webhook, and a Claude API key for the summaries
OPS_DISCORD_WEBHOOK=
ANTHROPIC_API_KEY=
